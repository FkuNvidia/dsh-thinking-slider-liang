    "deepseek-harness",
    "cordis",
    "reasoning-effort",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FkuNvidia/dsh-thinking-slider-liang.git"
  },
  "homepage": "https://github.com/FkuNvidia/dsh-thinking-slider-liang#readme",
  "bugs": {
    "url": "https://github.com/FkuNvidia/dsh-thinking-slider-liang/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
